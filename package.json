{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" build.ts bun-env.d.ts eslint.config.js playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test:domain": "bun test src/domain --pass-with-no-tests",
    "test:unit": "bun test src --pass-with-no-tests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:all": "sh scripts/verify-local.sh",
    "verify": "sh scripts/verify-local.sh",
    "audit": "sh scripts/audit.sh",
    "build": "bun run build.ts",
    "firebase:data": "bun run scripts/export-firebase-prototype-data.ts",
    "firebase:functions:build": "bun run firebase:data && cd functions && bun run build",
    "firebase:functions:lint": "bun run firebase:data && cd functions && bun run lint",
    "firebase:emulators": "bun run firebase:data && cd functions && bun run build && cd .. && firebase emulators:start --only functions,firestore",
    "firebase:dev": "sh scripts/firebase-local-dev.sh",
    "firebase:artifacts:setpolicy": "firebase functions:artifacts:setpolicy --location europe-west2 --days 7 --force",
    "firebase:deploy": "bun run firebase:data && bun run firebase:artifacts:setpolicy && firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "lucide-react": "^0.545.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.15.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/bun": "1.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "firebase-tools": "15.18.0",
    "globals": "17.6.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vercel": "54.4.1"
  }
}
